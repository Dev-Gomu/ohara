{
  "name": "ohara",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet && node scripts/lint-visual.mjs",
    "test": "vitest run --silent=passed-only",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "npm run build && playwright test",
    "tela": "node scripts/tela.mjs",
    "salvar": "bash scripts/salvar.sh",
    "e2e:curto": "npm run build --silent >/dev/null && playwright test --reporter=dot"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
